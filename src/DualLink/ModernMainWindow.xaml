<Window x:Class="DualLink.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="DualLink" Width="1000" Height="680" MinWidth="860" MinHeight="580" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource AppFont}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" AutomationProperties.Name="DualLink">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleIf" />
    <DataTemplate x:Key="LinkOptionTemplate">
      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}" />
    </DataTemplate>
    <Style x:Key="Drawer" TargetType="Border">
      <Setter Property="Width" Value="380" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
    </Style>
  </Window.Resources>
  <Border Background="{StaticResource ContentBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Border Background="{StaticResource CanvasBrush}" CornerRadius="12,12,0,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <Image Source="pack://application:,,,/DualLink;component/Assets/DualLink.ico" Width="25" Height="25" />
            <TextBlock Text="DualLink" FontSize="14" FontWeight="Medium" Margin="9,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="Details" Style="{StaticResource QuietButton}" Click="Details_Click" AutomationProperties.Name="Details" Margin="0,0,8,0" />
            <Button Content="Settings" Style="{StaticResource QuietButton}" Click="Settings_Click" AutomationProperties.Name="Settings" Margin="0,0,12,0" />
            <Button Content="—" Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
            <Button Content="×" Style="{StaticResource TitleBarButton}" FontSize="18" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="272" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0" CornerRadius="0,0,0,12">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,20,22,0">
              <Grid Margin="0,0,0,18">
                <TextBlock Text="Links" Style="{StaticResource SectionTitle}" />
                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="RefreshAdapters_Click" ToolTip="Refresh" AutomationProperties.Name="Refresh links">
                  <Path Data="M 14,6 A 6,6 0 1 0 15,11 M 14,3 L 14,7 L 10,7" Stroke="{StaticResource SecondaryBrush}" StrokeThickness="1.5" />
                </Button>
              </Grid>
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <Rectangle Width="5" Height="16" RadiusX="2" RadiusY="2" Fill="{StaticResource EthernetBrush}" Margin="0,0,9,0" />
                  <TextBlock Text="Ethernet" FontSize="14" FontWeight="Medium" />
                </StackPanel>
                <TextBlock Text="{Binding EthernetLinkState}" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" />
              </Grid>
              <ComboBox ItemsSource="{Binding EthernetLinks}" SelectedItem="{Binding SelectedEthernet}" ItemTemplate="{StaticResource LinkOptionTemplate}" Height="36" Margin="0,12,0,12" AutomationProperties.Name="Ethernet link" />
              <TextBlock Text="{Binding SelectedEthernet.SpeedText}" FontSize="17" FontWeight="Medium" ToolTip="Mbps" />
              <Grid Margin="0,9,0,0">
                <TextBlock Text="{Binding EthernetUsageText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <Button Content="Use only" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Padding="0,4" Click="EthernetOnly_Click" AutomationProperties.Name="Use Ethernet only" />
              </Grid>
              <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,18,0,22" />
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <Rectangle Width="5" Height="16" RadiusX="2" RadiusY="2" Fill="{StaticResource WifiBrush}" Margin="0,0,9,0" />
                  <TextBlock Text="Wi-Fi" FontSize="14" FontWeight="Medium" />
                </StackPanel>
                <TextBlock Text="{Binding WifiLinkState}" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" />
              </Grid>
              <ComboBox x:Name="WifiAdapterPicker" ItemsSource="{Binding WifiLinks}" SelectedItem="{Binding SelectedWifi}" ItemTemplate="{StaticResource LinkOptionTemplate}" Height="36" Margin="0,12,0,12" AutomationProperties.Name="Wi-Fi link" />
              <TextBlock Text="{Binding SelectedWifi.SpeedText}" FontSize="17" FontWeight="Medium" ToolTip="Mbps" />
              <Grid Margin="0,9,0,0">
                <TextBlock Text="{Binding WifiUsageText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <Button Content="Use only" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Padding="0,4" Click="WifiOnly_Click" AutomationProperties.Name="Use Wi-Fi only" />
              </Grid>
              <Button Content="Networks" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource QuietButton}" Padding="0,6" Click="WifiNetworks_Click" AutomationProperties.Name="Wi-Fi networks" />
              <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,16,0,22" />
              <Button Content="Use both" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Padding="0,4" Click="BothLinks_Click" AutomationProperties.Name="Use both links" />
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Grid Grid.Column="1" Margin="28,24,28,22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}" Margin="0,0,9,0" />
              <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="Medium" />
            </StackPanel>
            <Button x:Name="BoostButton" Content="Start" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="100" Height="40" Click="BoostButton_Click" AutomationProperties.Name="Start" />
          </Grid>
          <StackPanel Grid.Row="1" Margin="0,26,0,22">
            <TextBlock Text="{Binding TrafficScopeText}" Style="{StaticResource CaptionText}" />
            <Grid Margin="0,6,0,0">
              <TextBlock Text="{Binding CombinedSpeedText}" FontSize="40" FontWeight="Medium" Typography.NumeralAlignment="Tabular" />
              <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Upload" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding CombinedUploadSpeedText}" FontSize="15" Margin="0,5,0,0" HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
            <Viewbox Height="58" Stretch="Fill" Margin="0,18,0,14" ToolTip="{Binding TrafficHistoryToolTip}">
              <Grid Width="232" Height="28" ClipToBounds="True">
                <Line X1="0" Y1="27" X2="232" Y2="27" Stroke="{StaticResource DividerBrush}" StrokeThickness="0.4" />
                <Polyline Points="{Binding EthernetGraphPoints}" Stroke="{StaticResource EthernetBrush}" StrokeThickness="0.8" StrokeLineJoin="Round" />
                <Polyline Points="{Binding WifiGraphPoints}" Stroke="{StaticResource WifiBrush}" StrokeThickness="0.8" StrokeLineJoin="Round" />
              </Grid>
            </Viewbox>
            <Grid>
              <TextBlock Text="{Binding BoostContributionHeadline}" Style="{StaticResource CaptionText}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding SessionTrafficText}" FontWeight="Medium" />
                <TextBlock Text=" downloaded" Style="{StaticResource CaptionText}" />
              </StackPanel>
            </Grid>
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="12,9" Margin="0,14,0,0" Visibility="{Binding HasActionHint, Converter={StaticResource VisibleIf}}">
              <TextBlock Text="{Binding ActionHint}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
          <Grid Grid.Row="2" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Apps" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding AppScanText}" Style="{StaticResource CaptionText}" Margin="12,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Scan" Style="{StaticResource QuietButton}" Click="ScanApps_Click" AutomationProperties.Name="Scan installed apps" Margin="0,0,8,0" />
              <Button Content="+ Add" Click="AddExecutable_Click" AutomationProperties.Name="Add app" />
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="3" Text="No apps found" Style="{StaticResource CaptionText}" Margin="10,18" Visibility="{Binding HasNoApps, Converter={StaticResource VisibleIf}}" IsHitTestVisible="False" Panel.ZIndex="1" />
          <ListBox Grid.Row="3" ItemsSource="{Binding Profiles}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Apps" HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,12" CornerRadius="6">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="Transparent" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="42" />
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource RaisedBrush}" HorizontalAlignment="Left">
                      <Grid>
                        <TextBlock Text="{Binding Initial}" Foreground="{Binding Accent}" FontSize="17" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <Image Source="{Binding Icon}" Width="26" Height="26" />
                      </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" />
                    <TextBlock Grid.Column="2" Text="{Binding RunState}" Style="{StaticResource CaptionText}" Margin="12,0" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="×" Style="{StaticResource QuietButton}" Click="RemoveProfile_Click" ToolTip="Remove" AutomationProperties.Name="Remove app" Margin="0,0,6,0" Visibility="{Binding IsCustom, Converter={StaticResource VisibleIf}}" />
                    <CheckBox Grid.Column="4" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" HorizontalAlignment="Right" Click="ProfileSelection_Click" AutomationProperties.Name="{Binding Name}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
        <Border Grid.ColumnSpan="2" Background="#70000000" Panel.ZIndex="19" MouseLeftButtonDown="DrawerBackdrop_Click">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=DetailsDrawer}" Value="Visible">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visibility, ElementName=SettingsDrawer}" Value="Visible">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visibility, ElementName=AddAppDrawer}" Value="Visible">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Visibility, ElementName=WifiNetworksDrawer}" Value="Visible">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        </Border>
        <Border x:Name="DetailsDrawer" Grid.ColumnSpan="2" Style="{StaticResource Drawer}" Panel.ZIndex="20">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,24">
              <TextBlock Text="Details" Style="{StaticResource SectionTitle}" />
              <Button Content="×" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="CloseDrawer_Click" AutomationProperties.Name="Close details" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,0,0,20">
              <Grid>
                <TextBlock Text="Filter" Style="{StaticResource CaptionText}" />
                <TextBlock Text="{Binding PrerequisiteText}" HorizontalAlignment="Right" />
              </Grid>
              <Grid Margin="0,12,0,0">
                <TextBlock Text="Recovery" Style="{StaticResource CaptionText}" />
                <TextBlock Text="{Binding RecoveryText}" HorizontalAlignment="Right" />
              </Grid>
              <Grid Margin="0,12,0,0">
                <TextBlock Text="Connections" Style="{StaticResource CaptionText}" />
                <TextBlock Text="{Binding ActiveConnections}" HorizontalAlignment="Right" />
              </Grid>
              <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,18" />
              <TextBlock Text="{Binding BoostContributionHeadline}" FontWeight="Medium" />
              <TextBlock Text="{Binding BoostContributionSummary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
            <Grid Grid.Row="2">
              <Border x:Name="DiagnosticPanel">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                  </Grid.RowDefinitions>
                  <TextBlock Text="{Binding DiagnosticsSummaryText}" FontWeight="Medium" Margin="0,0,0,16" />
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Diagnostics}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
              <Border x:Name="ActivityPanel" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Activity}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </Grid>
            <Grid Grid.Row="3" Margin="0,18,0,0">
              <Button Content="Check" HorizontalAlignment="Left" Click="RunDiagnostics_Click" AutomationProperties.Name="Check links" />
              <Button x:Name="ActivityToggleButton" Content="Log" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Click="Activity_Click" AutomationProperties.Name="Show log" />
            </Grid>
          </Grid>
        </Border>
        <Border x:Name="SettingsDrawer" Grid.ColumnSpan="2" Style="{StaticResource Drawer}" Panel.ZIndex="20">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,24">
              <TextBlock Text="Settings" Style="{StaticResource SectionTitle}" />
              <Button Content="×" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="CloseDrawer_Click" AutomationProperties.Name="Close settings" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Grid Margin="0,0,0,22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Mode" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding RoutingModeOptions}" SelectedItem="{Binding SelectedRoutingModeOption}" Height="36" ToolTip="{Binding RoutingModeDescription}" AutomationProperties.Name="Mode" />
                </Grid>
                <Grid>
                  <TextBlock Text="Wait for app" VerticalAlignment="Center" />
                  <CheckBox IsChecked="{Binding AutoBoost}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Click="AutoBoost_Click" AutomationProperties.Name="Wait for selected apps to open" />
                </Grid>
                <Grid Margin="0,22,0,0">
                  <TextBlock Text="Keep in tray" VerticalAlignment="Center" />
                  <CheckBox IsChecked="{Binding CloseToTray}" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" AutomationProperties.Name="Keep running when closed" />
                </Grid>
                <Expander x:Name="SpeedLimits" Header="Limits" Margin="0,22,0,0" Foreground="{StaticResource SecondaryBrush}" AutomationProperties.Name="Speed limits">
                  <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="Ethernet" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                    <ComboBox x:Name="EthernetRouteLimit" ItemsSource="{Binding RouteSpeedOptions}" SelectedValuePath="Mbps" DisplayMemberPath="DisplayName" SelectedValue="{Binding SelectedEthernet.RouteControlMbps, Mode=TwoWay}" SelectionChanged="RouteLimit_SelectionChanged" Height="36" AutomationProperties.Name="Ethernet speed limit" />
                    <TextBlock Text="Wi-Fi" Style="{StaticResource CaptionText}" Margin="0,14,0,8" />
                    <ComboBox x:Name="WifiRouteLimit" ItemsSource="{Binding RouteSpeedOptions}" SelectedValuePath="Mbps" DisplayMemberPath="DisplayName" SelectedValue="{Binding SelectedWifi.RouteControlMbps, Mode=TwoWay}" SelectionChanged="RouteLimit_SelectionChanged" Height="36" AutomationProperties.Name="Wi-Fi speed limit" />
                  </StackPanel>
                </Expander>
                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,28" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Updates" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding UpdateChannelOptions}" SelectedItem="{Binding SelectedUpdateChannelOption}" Height="36" AutomationProperties.Name="Updates" />
                </Grid>
                <Button x:Name="UpdateCheckButton" Content="{Binding UpdateActionText}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="CheckUpdates_Click" AutomationProperties.Name="{Binding UpdateActionText}" />
                <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,0" />
              </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="{Binding VersionText}" Style="{StaticResource CaptionText}" />
          </Grid>
        </Border>
        <Border x:Name="AddAppDrawer" Grid.ColumnSpan="2" Style="{StaticResource Drawer}" Panel.ZIndex="20">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
              <TextBlock Text="Add app" Style="{StaticResource SectionTitle}" />
              <Button Content="×" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="CloseDrawer_Click" AutomationProperties.Name="Close app picker" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding RunningApplicationsStatusText}" Style="{StaticResource CaptionText}" Margin="0,0,0,18" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding RunningApplications}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding ExecutablePath}" Margin="0,0,12,0" />
                      <Button Grid.Column="1" Content="Add" Click="AddRunningApp_Click" AutomationProperties.Name="{Binding DisplayName}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button Grid.Row="3" Content="Browse files" HorizontalAlignment="Left" Margin="0,18,0,0" Click="BrowseExecutable_Click" AutomationProperties.Name="Browse for app" />
          </Grid>
        </Border>
        <Border x:Name="WifiNetworksDrawer" Grid.ColumnSpan="2" Style="{StaticResource Drawer}" Panel.ZIndex="20">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
              <TextBlock Text="Wi-Fi" Style="{StaticResource SectionTitle}" />
              <Button Content="×" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="CloseDrawer_Click" AutomationProperties.Name="Close Wi-Fi" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding WifiNetworksStatusText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding WifiNetworksStatusText}" Margin="0,0,8,0" />
              <Button Grid.Column="1" Content="Refresh" Style="{StaticResource QuietButton}" Click="RefreshWifiNetworks_Click" AutomationProperties.Name="Refresh Wi-Fi" />
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding WifiNetworks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,18">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="{Binding ActionText}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" Click="ConnectWifi_Click" AutomationProperties.Name="{Binding ActionText}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button Grid.Row="3" Content="Wi-Fi settings" HorizontalAlignment="Left" Margin="0,18,0,0" Click="OpenWindowsWifi_Click" AutomationProperties.Name="Open Windows Wi-Fi" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
