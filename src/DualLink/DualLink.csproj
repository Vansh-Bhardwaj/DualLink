<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\DualLink.ico</ApplicationIcon>
    <AssemblyName>DualLink</AssemblyName>
    <RootNamespace>DualLink</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <Authors>DualLink</Authors>
    <Product>DualLink Application Booster</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DualLink.Service.Protocol\DualLink.Service.Protocol.csproj" />
    <ProjectReference Include="..\DualLink.Core\DualLink.Core.csproj" />
    <Compile Remove="Routing.cs;Socks5Balancer.cs;TransferRateLimiter.cs;ProxiFyreManager.cs;BoostHealthMonitor.cs" />
    <Page Remove="MainWindow.xaml" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="..\..\assets\DualLink.ico" Link="Assets\DualLink.ico" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DualLink.UiTests" />
    <InternalsVisibleTo Include="DualLink.Tests" />
  </ItemGroup>
</Project>
