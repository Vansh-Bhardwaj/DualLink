<Window x:Class="DualLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DualLink" Width="1080" Height="700" MinWidth="940" MinHeight="620"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>

  <Border Background="{StaticResource CanvasBrush}" BorderBrush="#304158" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" CornerRadius="12,12,0,0"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
            <Border Width="26" Height="26" CornerRadius="8" Background="#183247" BorderBrush="#275675" BorderThickness="1">
              <TextBlock Text="DL" Foreground="{StaticResource WifiBrush}" FontFamily="Cascadia Mono, Consolas"
                         FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="DUAL/LINK" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="Bold"
                       Margin="9,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource QuietBrush}" FontSize="10" Margin="10,1,0,0" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Border Background="#111B25" BorderBrush="#304257" BorderThickness="1" CornerRadius="15" Padding="11,6" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{Binding StatusColor}" Margin="0,0,7,0" />
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Button Content="Details" Style="{StaticResource GhostButton}" Padding="11,6" Margin="0,0,6,0" Click="Details_Click" />
            <Button Content="Settings" Style="{StaticResource GhostButton}" Padding="11,6" Click="Settings_Click" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource TitleBarButton}" Content="—" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" ToolTip="Minimize to tray" Click="Minimize_Click" />
            <Button Style="{StaticResource TitleBarButton}" Content="×" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="17" ToolTip="Close" Click="Close_Click">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="CloseRoot" Background="Transparent" CornerRadius="0,11,0,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseRoot" Property="Background" Value="#B83D4E" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseRoot" Property="Background" Value="#8F2E3C" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="22,20,22,22">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

          <!-- Routes -->
          <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="16">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid>
                <StackPanel>
                  <TextBlock Text="ROUTES" Style="{StaticResource EyebrowText}" />
                  <TextBlock Text="Connection mix" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <Button Content="↻" Width="34" Height="34" Padding="0" FontSize="17" HorizontalAlignment="Right"
                        Style="{StaticResource GhostButton}" ToolTip="Refresh adapters" Click="RefreshAdapters_Click" />
              </Grid>

              <Border Grid.Row="2" Background="#131A22" BorderBrush="#4B3B24" BorderThickness="1" CornerRadius="11" Padding="13">
                <StackPanel>
                  <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="8" Height="8" Fill="{StaticResource EthernetBrush}" Margin="0,0,8,0" />
                      <TextBlock Text="ETHERNET" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EthernetBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedEthernet.SpeedText}" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold" />
                  </Grid>
                  <ComboBox Height="39" ItemsSource="{Binding EthernetLinks}" SelectedItem="{Binding SelectedEthernet}" DisplayMemberPath="DisplayName" Margin="0,11,0,12" />
                  <Grid>
                    <Button Content="Only" Style="{StaticResource GhostButton}" Padding="9,6" HorizontalAlignment="Left" ToolTip="Route new connections only through Ethernet" Click="EthernetOnly_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="−" Width="31" Height="31" Padding="0" Style="{StaticResource GhostButton}" Click="EthernetWeightDown_Click" />
                      <TextBlock Text="{Binding SelectedEthernet.WeightText}" Width="50" TextAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                      <Button Content="+" Width="31" Height="31" Padding="0" Style="{StaticResource GhostButton}" Click="EthernetWeightUp_Click" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Grid.Row="4" Background="#111B25" BorderBrush="#234A5E" BorderThickness="1" CornerRadius="11" Padding="13">
                <StackPanel>
                  <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="8" Height="8" Fill="{StaticResource WifiBrush}" Margin="0,0,8,0" />
                      <TextBlock Text="WI-FI / HOTSPOT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WifiBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedWifi.SpeedText}" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold" />
                  </Grid>
                  <ComboBox Height="39" ItemsSource="{Binding WifiLinks}" SelectedItem="{Binding SelectedWifi}" DisplayMemberPath="DisplayName" Margin="0,11,0,12" />
                  <Grid>
                    <Button Content="Only" Style="{StaticResource GhostButton}" Padding="9,6" HorizontalAlignment="Left" ToolTip="Route new connections only through Wi-Fi" Click="WifiOnly_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="−" Width="31" Height="31" Padding="0" Style="{StaticResource GhostButton}" Click="WifiWeightDown_Click" />
                      <TextBlock Text="{Binding SelectedWifi.WeightText}" Width="50" TextAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                      <Button Content="+" Width="31" Height="31" Padding="0" Style="{StaticResource GhostButton}" Click="WifiWeightUp_Click" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Grid.Row="5" Text="0 turns a route off for new connections." Foreground="{StaticResource QuietBrush}" FontSize="10" VerticalAlignment="Bottom" />
            </Grid>
          </Border>

          <!-- Apps -->
          <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="16">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid>
                <StackPanel>
                  <TextBlock Text="APPS" Style="{StaticResource EyebrowText}" />
                  <TextBlock Text="Boost these" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <Button Content="＋ Add app" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GhostButton}" Click="AddExecutable_Click" />
              </Grid>

              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,0,5,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" /><Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#172431" /><Setter Property="BorderBrush" Value="#3D6078" /></DataTrigger></Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="3" /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Click="ProfileSelection_Click" />
                          <Border Grid.Column="2" Width="3" CornerRadius="2" Background="{Binding Accent}" />
                          <StackPanel Grid.Column="4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                          </StackPanel>
                          <Border Grid.Column="5" CornerRadius="9" Padding="8,3" VerticalAlignment="Center">
                            <Border.Style>
                              <Style TargetType="Border"><Setter Property="Background" Value="#222D3A" /><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Background" Value="#153C30" /></DataTrigger></Style.Triggers></Style>
                            </Border.Style>
                            <TextBlock Text="{Binding RunState}" FontSize="9" FontWeight="Bold">
                              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- Primary command bar -->
        <Border Grid.Row="2" Background="#0E151E" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="18" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding AutoBoost, Mode=TwoWay}" Content="Automatic" Click="AutoBoost_Click" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Sessions" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,7,0" />
              <TextBlock Text="{Binding ActiveConnections}" FontWeight="SemiBold" FontSize="12" />
            </StackPanel>
            <Button Grid.Column="3" x:Name="BoostButton" Content="ARM AUTO-BOOST" Width="205" Height="44" Style="{StaticResource PrimaryButton}" Click="BoostButton_Click" />
          </Grid>
        </Border>

        <!-- Details drawer: advanced information stays hidden by default. -->
        <Border x:Name="DetailsDrawer" Grid.RowSpan="3" Width="370" HorizontalAlignment="Right" Background="#111923"
                BorderBrush="#3A5067" BorderThickness="1" CornerRadius="12" Padding="18" Visibility="Collapsed" Panel.ZIndex="10">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
              <StackPanel><TextBlock Text="DETAILS" Style="{StaticResource EyebrowText}" /><TextBlock Text="Diagnostics" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
              <Button Content="×" Width="32" Height="32" Padding="0" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Click="CloseDrawer_Click" />
            </Grid>
            <Border Grid.Row="2" Background="#0C141C" CornerRadius="9" Padding="12">
              <StackPanel>
                <Grid Margin="0,0,0,9"><TextBlock Text="Filter" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding PrerequisiteText}" HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" /></Grid>
                <Grid Margin="0,0,0,9"><TextBlock Text="Ethernet" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding SelectedEthernet.DiagnosticName}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" FontSize="10" /></Grid>
                <Grid Margin="0,0,0,9"><TextBlock Text="Wi-Fi" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding SelectedWifi.DiagnosticName}" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" FontSize="10" /></Grid>
                <Grid><TextBlock Text="Recovery" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="WATCHING" HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" /></Grid>
              </StackPanel>
            </Border>
            <Border Grid.Row="4" Background="#080D12" BorderBrush="#1E2A37" BorderThickness="1" CornerRadius="9" Padding="10">
              <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Activity}" Margin="0,0,4,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#91A3B8" FontFamily="Cascadia Mono, Consolas" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,7" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            </Border>
            <Button Grid.Row="6" Content="Check network filter" Style="{StaticResource GhostButton}" Click="InstallFilter_Click" />
          </Grid>
        </Border>

        <!-- Settings drawer -->
        <Border x:Name="SettingsDrawer" Grid.RowSpan="3" Width="370" HorizontalAlignment="Right" Background="#111923"
                BorderBrush="#3A5067" BorderThickness="1" CornerRadius="12" Padding="18" Visibility="Collapsed" Panel.ZIndex="11">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
              <StackPanel><TextBlock Text="SETTINGS" Style="{StaticResource EyebrowText}" /><TextBlock Text="App behavior" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
              <Button Content="×" Width="32" Height="32" Padding="0" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Click="CloseDrawer_Click" />
            </Grid>
            <Border Grid.Row="2" Background="#0C141C" CornerRadius="9" Padding="13">
              <StackPanel>
                <CheckBox IsChecked="{Binding CloseToTray, Mode=TwoWay}" Content="Close button keeps DualLink in tray" FontWeight="SemiBold" />
                <TextBlock Text="Exit from the tray menu to restore routing and stop DualLink." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="10" LineHeight="16" Margin="27,7,0,0" />
              </StackPanel>
            </Border>
            <Border Grid.Row="4" Background="#0C141C" CornerRadius="9" Padding="13">
              <Grid><TextBlock Text="Build" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding VersionText}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
            </Border>
            <TextBlock Grid.Row="6" Text="The minimize button always sends DualLink to the Windows status area." Foreground="{StaticResource QuietBrush}" TextWrapping="Wrap" FontSize="10" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
